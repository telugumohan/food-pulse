# Copy to `.env` and fill in. Every variable here is read by this app.

# The database this app connects to.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Signs session tokens. Any long random string; change it before deploying.
AUTH_SECRET="replace-with-a-long-random-secret"

# Name of the session cookie.
SESSION_COOKIE_NAME="app_session"

# Password of the seeded demo accounts (demo@example.com, <role>@example.com). Any value; the seed reads it. Unset, nobody can sign in as them.
DEMO_PASSWORD=""
